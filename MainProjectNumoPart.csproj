<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- MainProjectNumoPart.Tests lives in a subfolder of this project. Exclude it from every
         default item glob (not just Compile) so this project never sweeps up the test project's
         own bin/obj output as Content/None items — that caused runaway nested bin/ copies via
         the ProjectReference round-trip (each solution build added another nested layer). -->
    <Compile Remove="MainProjectNumoPart.Tests/**" />
    <Content Remove="MainProjectNumoPart.Tests/**" />
    <None Remove="MainProjectNumoPart.Tests/**" />
    <!-- Tools/FeatureReviewBot is the same situation: its own console project living in a
         subfolder of this one, project-referencing back to it. Same exclusion, same reason. -->
    <Compile Remove="Tools/**" />
    <Content Remove="Tools/**" />
    <None Remove="Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data/*.json files are read at runtime from AppContext.BaseDirectory (see
         Pages/Changelog.cshtml.cs), which is the PUBLISHED output directory, not the source
         tree — unlike wwwroot/, arbitrary files elsewhere in the project are not copied there
         automatically. Without this, the file exists in source and in git but 404s (silently,
         since ChangelogModel treats "file missing" as a valid empty state) the moment this ships
         inside the Docker image, which only contains published output. -->
    <None Include="Data\changelog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.5.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.29" />
    <!-- Pinned below v4: starting with 4.0.0, SixLabors added a build-time license-key check
         (SixLaborsLicensing.targets fails CoreCompile with "No Six Labors license found" unless
         $(SixLaborsLicenseKey)/a sixlabors.lic file is present). 3.1.12 is the last release under
         the older Split License with no build-time gate, and the APIs this project uses
         (Image.LoadAsync, Mutate/ResizeOptions, JpegEncoder) are unchanged across the two. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- SECURITY PINS for vulnerable TRANSITIVE dependencies.
       Neither package is referenced directly by this project; both arrive underneath the Azure
       Data Protection and EF Core SQLite packages above, at versions carrying published High
       advisories (re-check with: dotnet list package, passing the vulnerable + include-transitive
       flags).
       NuGet resolves a transitive to the *highest* version demanded across the graph, so naming
       them explicitly here is the supported way to float them up to a patched build without
       forking or upgrading the parents — the parents accept these versions, so nothing else moves.

       - System.Security.Cryptography.Xml: 8.0.2 -> 8.0.4. This one is genuinely reachable in
         production: the Data Protection key ring is XML, persisted to blob storage and encrypted
         with a Key Vault key (see Program.cs), so this code path runs on every cold start.
       - SQLitePCLRaw.lib.e_sqlite3: -> 2.1.13. SQLite is Development-only (Program.cs picks
         SqlServer outside Development), so this is not reachable in production — but the native
         library still ships inside the container image, so it is patched rather than argued about.

       Both are deliberately kept in the 8.0.x / 2.1.x lines to stay in-band with net8.0 rather
       than pulling 9.x runtime libraries into an 8.0 app. Revisit when the parents ship their own
       patched ranges, at which point these two lines can simply be deleted. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
