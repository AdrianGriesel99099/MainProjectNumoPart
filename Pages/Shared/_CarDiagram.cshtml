@* Pages/Shared/_CarDiagram.cshtml

   Five views of a car, one shown at a time, navigated by arrows on the panel itself.
   Used two ways:
     - coverage : shades parts that already have photos, click filters the page to that part
     - picker   : selects a part (also the fallback when WebGL is unavailable)

   Proportions come from a real sedan (4.7m x 1.8m x 1.45m), not guesswork: side 3.2:1,
   front/rear 1.25:1, top 2.6:1, wheels ~43% of body height. A stretched side view is the
   most obvious "this isn't a car" tell.

   Every clickable region carries data-part matching a Part enum member name. A part drawn in
   several views (the roof appears in four) shares that name, so selecting it lights up in all
   of them — and a mistyped name simply fails to light up with its siblings.
*@
@model MainProjectNumoPart.Pages.Shared.CarDiagramModel
@using MainProjectNumoPart.Models

<div class="car-diagram" data-mode="@Model.Mode" id="@Model.ElementId">
    <div class="car-diagram-head">
        <span class="car-view-name">Left side</span>
        <span class="flex-spacer"></span>
        @if (Model.Mode == "coverage")
        {
            <span class="car-legend">
                <span class="car-legend-swatch has"></span> has photos
                <span class="car-legend-swatch none"></span> nothing yet
            </span>
        }
    </div>

    <div class="car-stage">
        <button type="button" class="car-nav car-nav-left" data-nav="left" aria-label="Rotate left">&#8249;</button>
        <button type="button" class="car-nav car-nav-right" data-nav="right" aria-label="Rotate right">&#8250;</button>
        <button type="button" class="car-nav car-nav-up" data-nav="up" aria-label="Top view">&#8593;</button>
        <button type="button" class="car-nav car-nav-down" data-nav="down" aria-label="Back to side view">&#8595;</button>

        @* ---------- LEFT SIDE ----------
