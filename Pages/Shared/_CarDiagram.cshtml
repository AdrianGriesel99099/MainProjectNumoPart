        @* ---------- FRONT ---------- *@
        @* Scale 0.1321 units/mm, shared with the rear view. Centreline x=145, ground y=205,
           roof y=11 (1467mm). Body width x 20-270 (1891mm), across mirrors x 5-285 (2119mm),
           front track 1627mm putting the wheel centres at x 37.5 / 252.5.

           Note the left/right convention inherited from the original drawing: the car's LEFT
           is on the VIEWER'S LEFT, not the mirror-image arrangement you'd get from physically
           standing in front of the car. Changing it now would silently re-label every existing
           photo tagged HeadlightLeft. *@
        <svg class="car-view" data-view="front" viewBox="0 0 290 215" role="img" aria-label="Front of the car">
            <path class="car-body" d="M20,190 L20,120 C20,96 28,76 44,64 C46,32 58,11 78,11 L212,11 C232,11 244,32 246,64 C262,76 270,96 270,120 L270,190 C270,198 264,203 254,203 L36,203 C26,203 20,198 20,190 Z" />
            <path class="cp" data-part="Roof" d="M78,11 L212,11 L210,22 L80,22 Z" />
            <path class="cp" data-part="Windscreen" d="M80,23 L210,23 L242,60 L48,60 Z" />
            <path class="cp" data-part="Bonnet" d="M46,64 L244,64 L256,88 L34,88 Z" />
            <path class="cp" data-part="HeadlightLeft" d="M30,90 L100,87 L100,110 L28,113 Z" />
            <path class="cp" data-part="HeadlightRight" d="M260,90 L190,87 L190,110 L262,113 Z" />
            <path class="cp" data-part="FrontBumper" d="M24,118 L266,118 L266,184 C266,192 260,196 250,196 L40,196 C30,196 24,192 24,184 Z" />
            <path class="cp" data-part="MirrorLeft" d="M44,57 L10,62 L8,77 L44,74 Z" />
            <path class="cp" data-part="MirrorRight" d="M246,57 L280,62 L282,77 L246,74 Z" />
            @* The front track (1627mm) is narrower than the body (1891mm), so from dead ahead the
               wheels are hidden behind the bumper apart from the contact patch below it. Drawn at
               the true track positions (x 37.5 / 252.5) rather than at the body's outer corners,
               which is where the previous version had them poking out past the silhouette. *@
            <rect class="cp" data-part="WheelFrontLeft" x="25" y="192" width="26" height="13" rx="4" />
            <rect class="cp" data-part="WheelFrontRight" x="239" y="192" width="26" height="13" rx="4" />
            <g class="car-detail"><rect x="118" y="130" width="54" height="18" rx="3" fill="none" /></g>

            @* The ten front-end parts, layered AFTER the panels they sit within so they render
               on top and win the click: SpotlampLeft nests inside SpotlampGrillLeft, which nests
               inside BumperGrillFrontLeft, which sits within FrontBumper; CentreGrill nests
               inside MainGrill. This ordering is load-bearing — SVG resolves overlapping hits by
               document order, so moving any of these earlier makes the smaller one unreachable.
               (The 3D picker doesn't have this problem: car-body.js gives nested parts like
               SpotlampLeft real, separately-occluding geometry rather than overlapping invisible
               boxes, so THREE.js's own camera-distance hit resolution just works.) *@
            <rect class="cp" data-part="MainGrill" x="102" y="88" width="86" height="26" rx="3" />
            <rect class="cp" data-part="CentreGrill" x="126" y="94" width="38" height="14" rx="2" />
            <rect class="cp" data-part="FrontSpoiler" x="38" y="178" width="214" height="14" rx="3" />
            <rect class="cp" data-part="BumperGrillFrontLeft" x="30" y="126" width="54" height="42" rx="5" />
            <rect class="cp" data-part="BumperGrillFrontRight" x="206" y="126" width="54" height="42" rx="5" />
            <rect class="cp" data-part="SpotlampGrillLeft" x="38" y="132" width="38" height="30" rx="4" />
            <rect class="cp" data-part="SpotlampGrillRight" x="214" y="132" width="38" height="30" rx="4" />
            <circle class="cp" data-part="SpotlampLeft" cx="57" cy="147" r="11" />
            <circle class="cp" data-part="SpotlampRight" cx="233" cy="147" r="11" />
        </svg>

        @* ---------- REAR ---------- *@
        @* Same 0.1321 units/mm scale and frame as the front view, so rotating front->rear does
           not change the car's size. Rear track is 1582mm (narrower than the front's 1627mm),
           putting the wheel centres at x 40.5 / 249.5. *@
        <svg class="car-view" data-view="rear" viewBox="0 0 290 215" role="img" aria-label="Rear of the car">
            <path class="car-body" d="M20,190 L20,120 C20,96 28,76 44,64 C46,32 58,11 78,11 L212,11 C232,11 244,32 246,64 C262,76 270,96 270,120 L270,190 C270,198 264,203 254,203 L36,203 C26,203 20,198 20,190 Z" />
            <path class="cp" data-part="Roof" d="M78,11 L212,11 L210,22 L80,22 Z" />
            <path class="cp" data-part="RearWindscreen" d="M80,23 L210,23 L242,60 L48,60 Z" />
            <path class="cp" data-part="BootTailgate" d="M46,64 L244,64 L252,108 L38,108 Z" />
            <path class="cp" data-part="TaillightLeft" d="M28,112 L102,109 L102,134 L26,137 Z" />
            <path class="cp" data-part="TaillightRight" d="M262,112 L188,109 L188,134 L264,137 Z" />
            <path class="cp" data-part="RearBumper" d="M24,140 L266,140 L266,184 C266,192 260,196 250,196 L40,196 C30,196 24,192 24,184 Z" />
            <rect class="cp" data-part="WheelRearLeft" x="27" y="192" width="26" height="13" rx="4" />
            <rect class="cp" data-part="WheelRearRight" x="236" y="192" width="26" height="13" rx="4" />
            <rect class="cp" data-part="Undercarriage" x="95" y="192" width="100" height="14" rx="3" />
            <g class="car-detail"><rect x="118" y="80" width="54" height="18" rx="3" fill="none" /></g>

            @* Mounted on the trailing edge of the tailgate, so it deliberately dips into
               BootTailgate's own region — placed after it in the DOM, so clicks in that sliver
               correctly resolve to RearSpoiler, matching the same nested-region pattern used for
               the front bumper grilles. *@
            <rect class="cp" data-part="RearSpoiler" x="52" y="60" width="186" height="12" rx="2" />
        </svg>

        @* ---------- TOP ---------- *@
        @* Portrait, nose up, at the same 0.09 units/mm as the side views: length y 9-451
           (4910mm), body x 20-180, front axle y=84, rear axle y=351. Deliberately exempt from
           the "each view fills its frame" rule the other four follow, because CSS already sizes
           this one by max-height rather than width.

           The wheels straddle the body edge rather than sitting fully inside it. Strictly the
           track (1627mm) is narrower than the body (1891mm), so from directly above the wheels
           would be hidden under the arches entirely — and an invisible region is an unclickable
           one. Same schematic licence the previous version took, for the same reason. *@
        <svg class="car-view car-view-top" data-view="top" viewBox="0 0 200 460" role="img" aria-label="Top of the car">
            <path class="car-body" d="M72,14 C64,14 58,19 56,28 L40,78 C28,126 22,186 22,254 C22,322 28,382 40,424 C43,438 53,446 68,446 L132,446 C147,446 157,438 160,424 C172,382 178,322 178,254 C178,186 172,126 160,78 L144,28 C142,19 136,14 128,14 Z" />
            <path class="cp" data-part="FrontBumper" d="M72,14 C64,14 58,19 56,28 L51,45 L149,45 L144,28 C142,19 136,14 128,14 Z" />
            <path class="cp" data-part="HeadlightLeft" d="M46,50 L74,46 L76,58 L48,62 Z" />
            <path class="cp" data-part="HeadlightRight" d="M154,50 L126,46 L124,58 L152,62 Z" />
            <path class="cp" data-part="Bonnet" d="M52,64 L148,64 L153,110 L157,176 L43,176 L47,110 Z" />
            <path class="cp" data-part="WingFrontLeft" d="M50,47 L40,78 L31,140 L43,140 L47,110 L52,64 Z" />
            <path class="cp" data-part="WingFrontRight" d="M150,47 L160,78 L169,140 L157,140 L153,110 L148,64 Z" />
            <path class="cp" data-part="Windscreen" d="M43,180 L157,180 L152,232 L48,232 Z" />
            <path class="cp" data-part="Roof" d="M48,236 L152,236 L152,322 L48,322 Z" />
            <path class="cp" data-part="RearWindscreen" d="M48,326 L152,326 L157,366 L43,366 Z" />
            <path class="cp" data-part="BootTailgate" d="M44,370 L156,370 L152,404 L48,404 Z" />
            <path class="cp" data-part="RearBumper" d="M40,424 C43,438 53,446 68,446 L132,446 C147,446 157,438 160,424 L149,417 L51,417 Z" />
            <path class="cp" data-part="TaillightLeft" d="M44,406 L72,410 L70,422 L42,418 Z" />
            <path class="cp" data-part="TaillightRight" d="M156,406 L128,410 L130,422 L158,418 Z" />
            <path class="cp" data-part="DoorFrontLeft" d="M41,144 L26,146 L23,240 L38,240 Z" />
            <path class="cp" data-part="DoorFrontRight" d="M159,144 L174,146 L177,240 L162,240 Z" />
            <path class="cp" data-part="DoorRearLeft" d="M38,244 L23,244 L22,318 L37,318 Z" />
            <path class="cp" data-part="DoorRearRight" d="M162,244 L177,244 L178,318 L163,318 Z" />
            <path class="cp" data-part="QuarterRearLeft" d="M37,322 L22,322 L28,404 L42,400 Z" />
            <path class="cp" data-part="QuarterRearRight" d="M163,322 L178,322 L172,404 L158,400 Z" />
            <g class="car-detail">
                <path d="M43,178 L157,178 M48,234 L152,234 M48,324 L152,324 M44,368 L156,368" />
                <rect x="66" y="248" width="68" height="46" rx="4" fill="none" />
            </g>
            <rect class="cp" data-part="WheelFrontLeft" x="20" y="64" width="17" height="40" rx="6" />
            <rect class="cp" data-part="WheelFrontRight" x="163" y="64" width="17" height="40" rx="6" />
            <rect class="cp" data-part="WheelRearLeft" x="19" y="331" width="17" height="40" rx="6" />
            <rect class="cp" data-part="WheelRearRight" x="164" y="331" width="17" height="40" rx="6" />
            <path class="cp" data-part="MirrorLeft" d="M40,172 l-16,-5 l-4,11 l16,5 Z" />
            <path class="cp" data-part="MirrorRight" d="M160,172 l16,-5 l4,11 l-16,5 Z" />
        </svg>
    </div>

    @* These twelve have no honest position on a drawing of the car's outside, so they are plain
       buttons rather than invented hotspots that would be harder to find. Fenderliners (inside
       the wheel arch) and bumper slides (mounting brackets behind the bumper cover) joined the
       original six for the same reason. *@
    <div class="car-extras">
        @foreach (var part in new[] {
            Part.Interior, Part.EngineBay, Part.LoadArea, Part.Odometer, Part.Undercarriage, Part.Other,
            Part.FenderlinerFrontLeft, Part.FenderlinerFrontRight,
            Part.BumperSlideFrontLeft, Part.BumperSlideFrontRight,
            Part.BumperSlideRearLeft, Part.BumperSlideRearRight
        })
        {
            <button type="button" class="btn btn-sm btn-outline-secondary cp-btn" data-part="@part">@Html.DisplayFor(_ => part)</button>
        }
    </div>
</div>
