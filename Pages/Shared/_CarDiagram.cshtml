                <path class="cp" data-part="RearWindscreen" d="M324,20 L369,45 L359,50 L315,25 Z" />
                <path class="cp" data-part="DoorFrontRight" d="M140,70 L187,46 L243,46 L243,132 L140,132 Z" />
                <path class="cp" data-part="DoorRearRight" d="M243,46 L317,46 L317,132 L243,132 Z" />
                <path class="cp" data-part="QuarterRearRight" d="M317,46 L369,46 L430,52 L430,138 L317,138 Z" />
                <path class="cp" data-part="BootTailgate" d="M369,45 L432,51 L434,64 L366,58 Z" />
                <path class="cp" data-part="RearBumper" d="M432,51 C444,54 451,65 451,84 L451,138 L430,138 L430,58 Z" />
                <path class="cp" data-part="TaillightRight" d="M406,56 L430,60 L430,76 L406,72 Z" />
                <rect class="cp" data-part="SillRight" x="140" y="132" width="177" height="8" rx="3" />
                <g class="car-detail">
                    <path d="M140,70 L140,132 M243,46 L243,132 M317,46 L317,132 M72,82 L140,70 M369,46 L369,58" />
