            <circle class="car-tyre" cx="84" cy="120" r="30" />
            <circle class="car-rim" cx="84" cy="120" r="13" />
            <circle class="car-tyre" cx="351" cy="120" r="30" />
            <circle class="car-rim" cx="351" cy="120" r="13" />
