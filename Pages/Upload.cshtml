@* Pages/Upload.cshtml *@
@page
@model MainProjectNumoPart.Pages.UploadModel
@{
    ViewData["Title"] = "Upload photos";
}

<h2>Upload photos</h2>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.ContextVehicle is not null)
{
    <div class="alert alert-info col-md-6 d-flex justify-content-between align-items-start">
        <div>
            <div>Uploading to <strong>@(Model.ContextVehicle.MakeModel ?? "vehicle")</strong> @Model.ContextVehicle.Reg</div>
            <div class="job-vin">@Model.ContextVehicle.Vin</div>
            <div class="small text-muted mt-1">
                VIN and registration are prefilled below and stay editable — changing them files
                these photos under a different vehicle.
            </div>
        </div>
        <a class="btn btn-sm btn-outline-secondary"
           asp-page="/Vehicles/Details" asp-route-id="@Model.ContextVehicle.Id">Open vehicle</a>
    </div>
}

<form id="upload-form" method="post" enctype="multipart/form-data" class="col-md-6">
    @* Rendered only when it has a value, so the no-context path doesn't post an empty VehicleId. *@
    @if (Model.VehicleId.HasValue)
    {
        <input asp-for="VehicleId" type="hidden" />
    }
    <div class="mb-3">
        <label class="form-label">Stage</label>
        <select asp-for="Stage" class="form-select"
                asp-items="Html.GetEnumSelectList<MainProjectNumoPart.Models.Stage>()"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Part" class="form-label">Part (optional — you can tag these later instead)</label>
        @* Built manually rather than via Html.GetEnumSelectList<Part>(), which renders option
           VALUES as the numeric enum value ("14"), not the name. Nothing downstream currently
           depends on the name form specifically now that there is no picker JS syncing to this
           select, but model binding accepts either form on POST regardless. *@
        <select asp-for="Part" class="form-select mb-2">
            <option value="">— not set —</option>
            @foreach (var part in Enum.GetValues<MainProjectNumoPart.Models.Part>())
            {
                <option value="@part" selected="@(Model.Part == part)">@Html.DisplayFor(_ => part)</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Vin" class="form-label">VIN</label>
        <input asp-for="Vin" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Reg" class="form-label">Registration</label>
        <input asp-for="Reg" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DateTaken" class="form-label">Date taken (optional — read from the photo when possible)</label>
        <input asp-for="DateTaken" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Photos</label>
        <input asp-for="Files" type="file" class="form-control" multiple accept="image/jpeg,image/png" />
    </div>
    <button type="submit" id="upload-submit" class="btn btn-primary">Upload</button>
</form>

<script>
    // A multi-file batch genuinely takes several seconds (each file is buffered, thumbnailed,
    // and uploaded twice — original and thumbnail — before the redirect), and until now a click
    // gave no feedback at all. This is a plain form POST, not intercepted with preventDefault, so
    // the browser's own navigation still happens exactly as before; the spinner is just visible
    // until the next page loads. The 'submit' event only fires after the browser's own HTML5
    // validation passes, so a blocked/invalid submission never shows it.
    document.getElementById('upload-form').addEventListener('submit', () => {
        const btn = document.getElementById('upload-submit');
        btn.disabled = true; // blocks a double-click double-submitting the same batch
        btn.classList.add('btn-clicked');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Uploading…';
    });
</script>
