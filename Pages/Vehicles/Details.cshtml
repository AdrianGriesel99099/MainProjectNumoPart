@* Pages/Vehicles/Details.cshtml *@
@page "{id:int}"
@model MainProjectNumoPart.Pages.Vehicles.DetailsModel
@using MainProjectNumoPart.Models
@{
    ViewData["Title"] = Model.Vehicle.Vin ?? Model.Vehicle.Reg;
}

<div class="job-head">
    <div>
        <div class="job-plate">@(Model.Vehicle.MakeModel ?? "Vehicle") — @Model.Vehicle.Reg</div>
        <div class="job-vin">@Model.Vehicle.Vin</div>
    </div>
    <div class="d-flex gap-2">
        @if (User.CanUpload())
        {
            <a class="btn btn-outline-secondary" asp-page="/Vehicles/Edit" asp-route-id="@Model.Vehicle.Id">Edit details</a>
            <a class="btn btn-primary" asp-page="/Upload" asp-route-vehicleId="@Model.Vehicle.Id">+ Upload</a>
        }
    </div>
</div>

@foreach (var stage in Enum.GetValues<Stage>())
{
    var photos = Model.PhotosByStage[stage].ToList();
    <h3 class="stage-heading">@stage <span class="stage-count">(@photos.Count)</span></h3>
    @if (photos.Count == 0)
    {
        <p class="text-muted">No photos yet.</p>
    }
    else
    {
        <div class="photo-strip">
            @foreach (var photo in photos)
            {
                <div class="photo-tile" data-photo-id="@photo.Id" data-part="@(photo.Part?.ToString() ?? "")">
                    <img src="/api/photos/@photo.Id/thumbnail" loading="lazy"
                         alt="@stage photo @photo.SequenceNumber.ToString("000") for @(Model.Vehicle.Reg ?? Model.Vehicle.Vin)" />
                    <span class="photo-seq">@photo.SequenceNumber.ToString("000")</span>
                    @if (photo.Part is not null)
                    {
                        <span class="photo-part">@Html.DisplayFor(_ => photo.Part)</span>
                    }
                    @if (User.IsAdmin())
                    {
                        <button type="button" class="photo-delete" data-photo-id="@photo.Id" title="Delete">×</button>
                    }
                </div>
            }
        </div>
    }
}

@* data-selection-ids marks this as a form multiselect.js should populate with the selected
   photo ids. It used to be found by its hard-coded id; the attribute is what allows a second
   bulk action to share the same selection. *@
<form id="selection-download-form" data-selection-ids method="post" action="/api/photos/download"></form>

<div id="selection-bar" class="selection-bar d-none">
    <span id="selection-count"></span>
    <span class="flex-spacer"></span>
    @if (User.CanUpload())
    {
        <select id="tag-part" class="form-select form-select-sm" style="width:auto" aria-label="Set part for selected photos">
            <option value="">Set part…</option>
            <option value="__clear__">— clear part —</option>
            @foreach (var part in Enum.GetValues<MainProjectNumoPart.Models.Part>())
            {
                <option value="@part">@Html.DisplayFor(_ => part)</option>
            }
        </select>
    }
    <button type="button" id="selection-clear" class="btn btn-sm btn-outline-light">Clear</button>
    <button type="submit" form="selection-download-form" class="btn btn-sm btn-primary">⬇ Download zip</button>
</div>

<script src="~/js/multiselect.js"></script>

@if (User.CanUpload())
{
    <script>
        document.getElementById('tag-part').addEventListener('change', async (e) => {
            const raw = e.target.value;
            if (!raw) return;
            const ids = window.PhotoSelection.ids();
            if (ids.length === 0) { e.target.value = ''; return; }

            const response = await fetch('/api/photos/part', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids, part: raw === '__clear__' ? null : raw })
            });

            // Exact status, not response.ok — a role-denied request answers 302 to
            // /Account/AccessDenied, which fetch follows to a 200 and would look like success.
            if (response.status === 200) {
                window.location.reload();
            } else {
                alert(await response.text() || 'Could not set the part.');
                e.target.value = '';
            }
        });
    </script>
}

@if (User.IsAdmin())
{
    <script>
        document.querySelectorAll('.photo-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this photo? This cannot be undone.')) return;
                const id = btn.dataset.photoId;
                const response = await fetch(`/api/photos/${id}`, { method: 'DELETE' });
                // Check the exact success status, NOT response.ok. A role-denied request is
                // answered with a 302 to /Account/AccessDenied, which fetch follows to a 200 HTML
                // page — response.ok would be true and the tile would vanish while the photo
                // survived, telling the user a deletion happened that didn't.
                if (response.status === 204) {
                    document.querySelector(`.photo-tile[data-photo-id="${id}"]`).remove();
                } else {
                    alert('Delete failed.');
                }
            });
        });
    </script>

    @* Control and script both inside this single admin gate, matching the per-photo delete above:
       a non-admin receives no delete markup and no delete JavaScript at all. *@
    <div class="danger-zone mt-5">
        <h4 class="text-danger">Delete this vehicle</h4>
        <p class="text-muted small mb-2">
            Permanently removes this vehicle, all @Model.Vehicle.Photos.Count photo records, and
            every stored image file. This cannot be undone.
        </p>
        <label class="form-label small" for="delete-confirm">
            Type <code>@(Model.Vehicle.Vin ?? Model.Vehicle.Reg)</code> to confirm
        </label>
        <input id="delete-confirm" class="form-control" style="max-width:340px" autocomplete="off" />
        <button type="button" id="delete-vehicle" class="btn btn-danger mt-2"
                data-vehicle-id="@Model.Vehicle.Id">Delete vehicle</button>
        <div id="delete-error" class="text-danger small mt-2"></div>
    </div>

    <script>
        document.getElementById('delete-vehicle').addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            const confirmation = document.getElementById('delete-confirm').value;
            if (!confirm('Delete this vehicle and all of its photos? This cannot be undone.')) return;

            btn.disabled = true;
            const response = await fetch(`/api/vehicles/${btn.dataset.vehicleId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ confirmation })
            });

            // Exact status, not response.ok — see the note on the photo delete above. The typed
            // confirmation is re-checked server-side; this input is convenience, not the control.
            if (response.status === 204) {
                window.location.href = '/';
                return;
            }

            btn.disabled = false;
            document.getElementById('delete-error').textContent =
                (await response.text()) || 'Delete failed.';
        });
    </script>
}
