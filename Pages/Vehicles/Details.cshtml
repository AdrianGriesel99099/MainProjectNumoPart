@* Pages/Vehicles/Details.cshtml *@
@page "{id:int}"
@model MainProjectNumoPart.Pages.Vehicles.DetailsModel
@using MainProjectNumoPart.Models
@{
    ViewData["Title"] = Model.Vehicle.Vin ?? Model.Vehicle.Reg;
}

<div class="job-head">
    <div>
        <div class="job-plate">@(Model.Vehicle.MakeModel ?? "Vehicle") — @Model.Vehicle.Reg</div>
        <div class="job-vin">@Model.Vehicle.Vin</div>
    </div>
    <div class="d-flex gap-2">
        @if (User.CanUpload())
        {
            <a class="btn btn-outline-secondary" asp-page="/Vehicles/Edit" asp-route-id="@Model.Vehicle.Id">Edit details</a>
            <a class="btn btn-primary" asp-page="/Upload" asp-route-vehicleId="@Model.Vehicle.Id">+ Upload</a>
        }
    </div>
</div>

<details class="job-card mb-3" open>
    <summary>
        Job card
        <span class="text-muted small">— @Model.UpdatesNewestFirst.Count update(s)</span>
    </summary>

    @if (Model.UpdatesNewestFirst.Count == 0)
    {
        <p class="text-muted small mt-2">No updates yet.</p>
    }
    else
    {
        <ul class="list-unstyled job-card-list mt-2">
            @foreach (var update in Model.UpdatesNewestFirst)
            {
                <li class="job-card-entry mb-2 pb-2 border-bottom" data-update-id="@update.Id">
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">@update.AuthorEmail</span>
                        <span class="text-muted small">@update.CreatedAtUtc.ToString("d MMM yyyy, HH:mm")</span>
                    </div>
                    <p class="mb-1" style="white-space: pre-wrap;">@update.Body</p>
                    @if (User.IsAdmin())
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger job-update-delete" data-update-id="@update.Id">Delete</button>
                    }
                </li>
            }
        </ul>
    }

    @if (User.CanUpload())
    {
        <form id="add-update-form" class="mt-2">
            <textarea id="update-body" class="form-control" rows="2" placeholder="Add an update…" maxlength="2000"></textarea>
            <button type="submit" class="btn btn-sm btn-primary mt-2">Post update</button>
            <div id="update-error" class="text-danger small mt-1"></div>
        </form>
    }
</details>

@if (User.CanUpload())
{
    <script>
        document.getElementById('add-update-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const body = document.getElementById('update-body').value;
            const response = await fetch('/api/vehicles/@Model.Vehicle.Id/updates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ body })
            });
            // Exact status, not response.ok — a role-denied request answers 302 to
            // /Account/AccessDenied, which fetch follows to a 200 and would look like success.
            if (response.status === 200) {
                window.location.reload();
            } else {
                document.getElementById('update-error').textContent =
                    (await response.text()) || 'Could not post the update.';
            }
        });
    </script>
}

@if (User.IsAdmin())
{
    <script>
        document.querySelectorAll('.job-update-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this update? This cannot be undone.')) return;
                const id = btn.dataset.updateId;
                const response = await fetch(`/api/vehicles/updates/${id}`, { method: 'DELETE' });
                if (response.status === 204) {
                    document.querySelector(`.job-card-entry[data-update-id="${id}"]`).remove();
                } else {
                    alert('Delete failed.');
                }
            });
        });
    </script>
}

@if (Model.Vehicle.Photos.Count > 0)
{
    <details class="coverage-panel mb-3" open>
        <summary>
            Photo coverage
            <span class="text-muted small">
                — @Model.PhotoCountsByPart.Count of @(Enum.GetValues<MainProjectNumoPart.Models.Part>().Length) parts covered@(Model.UntaggedCount > 0 ? $", {Model.UntaggedCount} photo(s) untagged" : "")
            </span>
        </summary>
        <partial name="_CarDiagram" model="@(new MainProjectNumoPart.Pages.Shared.CarDiagramModel { Mode = "coverage", ElementId = "coverage-diagram", PhotoCounts = Model.PhotoCountsByPart })" />
        <div id="coverage-filter-note" class="small mt-2"></div>
    </details>
}

@foreach (var stage in Enum.GetValues<Stage>())
{
    var photos = Model.PhotosByStage[stage].ToList();
    <h3 class="stage-heading">@stage <span class="stage-count">(@photos.Count)</span></h3>
    @if (photos.Count == 0)
    {
        <p class="text-muted">No photos yet.</p>
    }
    else
    {
        <div class="photo-strip">
            @foreach (var photo in photos)
            {
                <div class="photo-tile" data-photo-id="@photo.Id" data-part="@(photo.Part?.ToString() ?? "")">
                    <img src="/api/photos/@photo.Id/thumbnail" loading="lazy"
                         alt="@stage photo @photo.SequenceNumber.ToString("000") for @(Model.Vehicle.Reg ?? Model.Vehicle.Vin)" />
                    <span class="photo-seq">@photo.SequenceNumber.ToString("000")</span>
                    @if (photo.Part is not null)
                    {
                        <span class="photo-part">@Html.DisplayFor(_ => photo.Part)</span>
                    }
                    <a class="photo-view" asp-page="/Photos/View" asp-route-id="@photo.Id" title="View photo">⤢</a>
                    @if (User.IsAdmin())
                    {
                        <button type="button" class="photo-delete" data-photo-id="@photo.Id" title="Delete">×</button>
                    }
                </div>
            }
        </div>
    }
}

@* data-selection-ids marks this as a form multiselect.js should populate with the selected
   photo ids. It used to be found by its hard-coded id; the attribute is what allows a second
   bulk action to share the same selection. *@
<form id="selection-download-form" data-selection-ids method="post" action="/api/photos/download"></form>

@if (User.CanUpload())
{
    @* The 3D picker needs real vertical space that a sticky bottom bar cannot spare, so it
       lives in a collapsible panel above the bar instead of inline in it. Both it and the
       compact select in the bar itself target the same #tag-part element. *@
    <div id="tag-part-panel" class="d-none mb-2">
        <partial name="_CarPicker" model="@(new MainProjectNumoPart.Pages.Shared.CarPickerModel { ElementId = "selection-car-picker", SelectElementId = "tag-part" })" />
    </div>
}

<div id="selection-bar" class="selection-bar d-none">
    <span id="selection-count"></span>
    <span class="flex-spacer"></span>
    @if (User.CanUpload())
    {
        <button type="button" id="tag-part-toggle" class="btn btn-sm btn-outline-light">Pick on car</button>
        <select id="tag-part" class="form-select form-select-sm" style="width:auto" aria-label="Set part for selected photos">
            <option value="">Set part…</option>
            <option value="__clear__">— clear part —</option>
            @foreach (var part in Enum.GetValues<MainProjectNumoPart.Models.Part>())
            {
                <option value="@part">@Html.DisplayFor(_ => part)</option>
            }
        </select>
    }
    <button type="button" id="selection-clear" class="btn btn-sm btn-outline-light">Clear</button>
    <button type="submit" form="selection-download-form" class="btn btn-sm btn-primary">⬇ Download zip</button>
</div>

<script src="~/js/multiselect.js"></script>

@if (Model.Vehicle.Photos.Count > 0)
{
    <script src="~/js/cardiagram.js"></script>
    <script>
        (function () {
            const diagram = document.getElementById('coverage-diagram');
            if (!diagram || !diagram.applyCoverage) return;

            const counts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.PhotoCountsByPart.ToDictionary(k => k.Key.ToString(), v => v.Value)));
            diagram.applyCoverage(Object.keys(counts));

            const note = document.getElementById('coverage-filter-note');
            let active = null;

            // Filtering is client-side: the photos are already on the page, so a round-trip
            // would only make it slower and lose the selection.
            diagram.addEventListener('carpartfiltered', (e) => {
                const part = e.detail.part;
                active = (active === part) ? null : part;
                diagram.setSelected(active);

                document.querySelectorAll('.photo-tile').forEach(t => {
                    t.classList.toggle('part-hidden', active !== null && t.dataset.part !== active);
                });

                if (active === null) {
                    note.textContent = '';
                } else {
                    const n = counts[active] || 0;
                    note.innerHTML = n === 0
                        ? '<span class="text-danger">No photos of that part yet.</span> <a href="#" id="coverage-clear">Show all</a>'
                        : `Showing ${n} photo(s) of that part. <a href="#" id="coverage-clear">Show all</a>`;
                }

                document.getElementById('coverage-clear')?.addEventListener('click', (ev) => {
                    ev.preventDefault();
                    active = null;
                    diagram.clearSelection();
                    document.querySelectorAll('.photo-tile').forEach(t => t.classList.remove('part-hidden'));
                    note.textContent = '';
                });
            });
        })();
    </script>
}

@if (User.CanUpload())
{
    <script>
        document.getElementById('tag-part-toggle').addEventListener('click', () => {
            const panel = document.getElementById('tag-part-panel');
            panel.classList.toggle('d-none');
            // The picker measured its container's width while the panel was display:none and
            // got 0 back — car3d.js now skips sizing to 0 rather than locking it in, but still
            // needs telling once real layout exists. Without this the canvas stays invisible
            // even though .car-picker-3d itself is no longer hidden.
            //
            // Deferred with setTimeout rather than called synchronously: removing d-none only
            // SCHEDULES a layout recalculation, it doesn't force one, so a resize() called in
            // the same tick can still read the pre-toggle clientWidth (0) back — confirmed by
            // instrumenting car3d.js and finding clientWidth still 0 immediately after the
            // class was already removed. One tick later, the browser has laid the panel out.
            setTimeout(() => {
                const picker = document.getElementById('selection-car-picker');
                if (picker && picker.resize) picker.resize();
            }, 0);
        });

        document.getElementById('tag-part').addEventListener('change', async (e) => {
            const raw = e.target.value;
            if (!raw) return;
            const ids = window.PhotoSelection.ids();
            if (ids.length === 0) { e.target.value = ''; return; }

            const response = await fetch('/api/photos/part', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids, part: raw === '__clear__' ? null : raw })
            });

            // Exact status, not response.ok — a role-denied request answers 302 to
            // /Account/AccessDenied, which fetch follows to a 200 and would look like success.
            if (response.status === 200) {
                window.location.reload();
            } else {
                alert(await response.text() || 'Could not set the part.');
                e.target.value = '';
            }
        });
    </script>
}

@if (User.IsAdmin())
{
    <script>
        document.querySelectorAll('.photo-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this photo? This cannot be undone.')) return;
                const id = btn.dataset.photoId;
                const response = await fetch(`/api/photos/${id}`, { method: 'DELETE' });
                // Check the exact success status, NOT response.ok. A role-denied request is
                // answered with a 302 to /Account/AccessDenied, which fetch follows to a 200 HTML
                // page — response.ok would be true and the tile would vanish while the photo
                // survived, telling the user a deletion happened that didn't.
                if (response.status === 204) {
                    document.querySelector(`.photo-tile[data-photo-id="${id}"]`).remove();
                } else {
                    alert('Delete failed.');
                }
            });
        });
    </script>

    @* Control and script both inside this single admin gate, matching the per-photo delete above:
       a non-admin receives no delete markup and no delete JavaScript at all. *@
    <div class="danger-zone mt-5">
        <h4 class="text-danger">Delete this vehicle</h4>
        <p class="text-muted small mb-2">
            Permanently removes this vehicle, all @Model.Vehicle.Photos.Count photo records, and
            every stored image file. This cannot be undone.
        </p>
        <label class="form-label small" for="delete-confirm">
            Type <code>@(Model.Vehicle.Vin ?? Model.Vehicle.Reg)</code> to confirm
        </label>
        <input id="delete-confirm" class="form-control" style="max-width:340px" autocomplete="off" />
        <button type="button" id="delete-vehicle" class="btn btn-danger mt-2"
                data-vehicle-id="@Model.Vehicle.Id">Delete vehicle</button>
        <div id="delete-error" class="text-danger small mt-2"></div>
    </div>

    <script>
        document.getElementById('delete-vehicle').addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            const confirmation = document.getElementById('delete-confirm').value;
            if (!confirm('Delete this vehicle and all of its photos? This cannot be undone.')) return;

            btn.disabled = true;
            const response = await fetch(`/api/vehicles/${btn.dataset.vehicleId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ confirmation })
            });

            // Exact status, not response.ok — see the note on the photo delete above. The typed
            // confirmation is re-checked server-side; this input is convenience, not the control.
            if (response.status === 204) {
                window.location.href = '/';
                return;
            }

            btn.disabled = false;
            document.getElementById('delete-error').textContent =
                (await response.text()) || 'Delete failed.';
        });
    </script>
}
