@* Pages/Vehicles/Details.cshtml *@
@page "{id:int}"
@model MainProjectNumoPart.Pages.Vehicles.DetailsModel
@using MainProjectNumoPart.Models
@{
    ViewData["Title"] = Model.Vehicle.Vin ?? Model.Vehicle.Reg;
}

<div class="job-head">
    <div>
        <div class="job-plate">@(Model.Vehicle.MakeModel ?? "Vehicle") — @Model.Vehicle.Reg</div>
        <div class="job-vin">@Model.Vehicle.Vin</div>
    </div>
    <div class="d-flex gap-2">
        @if (User.CanUpload())
        {
            <a class="btn btn-outline-secondary" asp-page="/Vehicles/Edit" asp-route-id="@Model.Vehicle.Id">Edit details</a>
            <a class="btn btn-primary" asp-page="/Upload" asp-route-vehicleId="@Model.Vehicle.Id">+ Upload</a>
        }
    </div>
</div>

<details class="job-card mb-3" open>
    <summary>
        Job card
        <span class="text-muted small">— @Model.UpdatesNewestFirst.Count update(s)</span>
    </summary>

    @if (Model.UpdatesNewestFirst.Count == 0)
    {
        <p class="text-muted small mt-2">No updates yet.</p>
    }
    else
    {
        <ul class="list-unstyled job-card-list mt-2">
            @foreach (var update in Model.UpdatesNewestFirst)
            {
                <li class="job-card-entry mb-2 pb-2 border-bottom" data-update-id="@update.Id">
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">@update.AuthorEmail</span>
                        <span class="text-muted small">@update.CreatedAtUtc.ToString("d MMM yyyy, HH:mm")</span>
                    </div>
                    <p class="mb-1" style="white-space: pre-wrap;">@update.Body</p>
                    @if (User.IsAdmin())
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger job-update-delete" data-update-id="@update.Id">Delete</button>
                    }
                </li>
            }
        </ul>
    }

    @if (User.CanUpload())
    {
        <form id="add-update-form" class="mt-2">
            <textarea id="update-body" class="form-control" rows="2" placeholder="Add an update…" maxlength="2000"></textarea>
            <button type="submit" class="btn btn-sm btn-primary mt-2">Post update</button>
            <div id="update-error" class="text-danger small mt-1"></div>
        </form>
    }
</details>

@if (User.CanUpload())
{
    <script>
        document.getElementById('add-update-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const body = document.getElementById('update-body').value;
            const response = await fetch('/api/vehicles/@Model.Vehicle.Id/updates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ body })
            });
            // Exact status, not response.ok — a role-denied request answers 302 to
            // /Account/AccessDenied, which fetch follows to a 200 and would look like success.
            if (response.status === 200) {
                window.location.reload();
            } else {
                document.getElementById('update-error').textContent =
                    (await response.text()) || 'Could not post the update.';
            }
        });
    </script>
}

@if (User.IsAdmin())
{
    <script>
        document.querySelectorAll('.job-update-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this update? This cannot be undone.')) return;
                const id = btn.dataset.updateId;
                const response = await fetch(`/api/vehicles/updates/${id}`, { method: 'DELETE' });
                if (response.status === 204) {
                    document.querySelector(`.job-card-entry[data-update-id="${id}"]`).remove();
                } else {
                    alert('Delete failed.');
                }
            });
        });
    </script>
}

@* Always rendered, unlike the coverage list below — marking damage should work from the moment
   a vehicle exists, before any photo has been taken, so it can't depend on Photos.Count. *@
@* The trigger below is shown to every role, not just uploaders — picking a part and opening
   the popup is also how anyone browses that part's existing marks/photo. Whether the popup lets
   you actually ADD a new one is gated inside it by window.__canMarkDamage (see damagemarks.js),
   the same split the diagram-based version had: clicking opened the popup for everyone, only
   the pending-click-to-place behaviour inside it was upload-role-gated. *@
<details class="mark-damage mb-3">
    <summary>Mark damage</summary>
    <div class="d-flex gap-2 align-items-end mt-2 mb-2" style="max-width:420px">
        <div class="flex-grow-1">
            <label for="damage-mark-part-select" class="form-label small mb-1">Part</label>
            <select id="damage-mark-part-select" class="form-select form-select-sm">
                @foreach (var part in Enum.GetValues<MainProjectNumoPart.Models.Part>())
                {
                    <option value="@part">@Html.DisplayFor(_ => part)</option>
                }
            </select>
        </div>
        <button type="button" id="damage-mark-open" class="btn btn-sm btn-primary">Open</button>
    </div>
</details>

<details class="damage-marks-list mb-3">
    <summary>
        Damage marks
        <span class="text-muted small">— @Model.DamageMarksNewestFirst.Count mark(s)</span>
    </summary>

    @if (Model.DamageMarksNewestFirst.Count == 0)
    {
        <p class="text-muted small mt-2">No damage marks yet.</p>
    }
    else
    {
        <ul class="list-unstyled mt-2">
            @foreach (var mark in Model.DamageMarksNewestFirst)
            {
                <li class="mb-2 pb-2 border-bottom d-flex gap-2" data-mark-id="@mark.Id">
                    @if (mark.Photo is not null)
                    {
                        <img src="/api/photos/@mark.Photo.Id/thumbnail" style="width:60px;height:45px;object-fit:cover;border-radius:4px;flex-shrink:0" alt="" />
                    }
                    else
                    {
                        <div class="text-muted small" style="width:60px;flex-shrink:0">(no photo)</div>
                    }
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold">@Html.DisplayFor(_ => mark.Part)</span>
                            <span class="text-muted small">@mark.CreatedAtUtc.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        <p class="mb-1 small" style="white-space: pre-wrap;">@mark.Note</p>
                        <span class="text-muted small">@mark.AuthorEmail</span>
                        @if (User.IsAdmin())
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger damage-mark-delete ms-2" data-mark-id="@mark.Id">Delete</button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</details>

@* One modal, reused for every part — damagemarks.js populates it on 'carpartmarked'.
   Bootstrap's own modal component, not a hand-rolled one: bootstrap.bundle.min.js is already
   vendored and loaded on every page, and no modal pattern exists anywhere else in this app to
   be consistent with, so reusing battle-tested show/hide, backdrop and focus-trap behaviour
   beats inventing a new one. *@
<div class="modal fade" id="damage-mark-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="damage-mark-title">Mark damage</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @* No tab selector: with the diagram gone there is only one real visual option
                   (a tagged photo of the part, if one exists) plus the text-only fallback when
                   there isn't one — damagemarks.js picks between them automatically, there is
                   nothing left for the user to choose between. *@
                <select id="damage-mark-photo-select" class="form-select form-select-sm mb-2 d-none"></select>
                <div id="damage-mark-canvas-wrap" class="damage-mark-canvas-wrap"></div>
                <form id="damage-mark-note-form" class="d-none mt-2">
                    <textarea id="damage-mark-note" class="form-control" rows="2" placeholder="What's the damage?" maxlength="2000"></textarea>
                    <div class="mt-2">
                        <button type="submit" class="btn btn-sm btn-primary">Save mark</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="damage-mark-cancel">Cancel</button>
                    </div>
                    <div id="damage-mark-error" class="text-danger small mt-1"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@* bootstrap.bundle.min.js loads at the very bottom of _Layout.cshtml's <body>, AFTER
   @RenderBody() — i.e. after this entire page's own inline scripts. damagemarks.js calls `new
   bootstrap.Modal(...)` at load time, so it must run AFTER bootstrap, not inline here. Wrapping
   it (and the data it reads) in @section Scripts renders it where _Layout's own
   @await RenderSectionAsync("Scripts", ...) is placed — after bootstrap — which is the only
   script on this page with that dependency; every other one here is self-contained. *@
@section Scripts {
    <script>
        // Preloaded once rather than fetched per part-click: at this app's scale (a workshop's
        // worth of photos and marks per vehicle) this is a handful of KB, and it means opening the
        // popup for a different part is instant client-side filtering, not another round-trip.
        window.__damageMarksData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DamageMarksNewestFirst.Select(m => new {
            id = m.Id, part = m.Part.ToString(), photoId = m.PhotoId,
            xPercent = m.XPercent, yPercent = m.YPercent, note = m.Note, authorEmail = m.AuthorEmail
        })));
        window.__vehiclePhotosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Vehicle.Photos
            .Where(p => p.Part.HasValue)
            .OrderByDescending(p => p.UploadedAtUtc)
            .Select(p => new { id = p.Id, part = p.Part!.Value.ToString(), label = p.Stage + " #" + p.SequenceNumber.ToString("000") })));
        window.__vehicleId = @Model.Vehicle.Id;
        window.__isAdmin = @Json.Serialize(User.IsAdmin());
        window.__canMarkDamage = @Json.Serialize(User.CanUpload());
    </script>
    <script src="~/js/damagemarks.js"></script>
}

@if (Model.Vehicle.Photos.Count > 0)
{
    <details class="coverage-panel mb-3" open>
        <summary>
            Photo coverage
            <span class="text-muted small">
                — @Model.PhotoCountsByPart.Count of @(Enum.GetValues<MainProjectNumoPart.Models.Part>().Length) parts covered@(Model.UntaggedCount > 0 ? $", {Model.UntaggedCount} photo(s) untagged" : "")
            </span>
        </summary>
        @* One badge per part that has at least one photo — click toggles filtering the photo
           strips below to that part, same behaviour the coverage diagram used to drive by
           clicking a shaded region. Parts with zero photos aren't listed at all: with no diagram
           there is no "everything, shaded or not" surface to show them against, and 78 possible
           parts is too many empty badges to scan for the ones that matter. *@
        <div id="coverage-badges" class="d-flex flex-wrap gap-2 mt-2">
            @foreach (var kvp in Model.PhotoCountsByPart.OrderBy(kvp => kvp.Key.ToString()))
            {
                <button type="button" class="btn btn-sm btn-outline-secondary coverage-badge" data-part="@kvp.Key">
                    @Html.DisplayFor(_ => kvp.Key) <span class="text-muted">(@kvp.Value)</span>
                </button>
            }
        </div>
        <div id="coverage-filter-note" class="small mt-2"></div>
    </details>
}

@foreach (var stage in Enum.GetValues<Stage>())
{
    var photos = Model.PhotosByStage[stage].ToList();
    <h3 class="stage-heading">@stage <span class="stage-count">(@photos.Count)</span></h3>
    @if (photos.Count == 0)
    {
        <p class="text-muted">No photos yet.</p>
    }
    else
    {
        <div class="photo-strip">
            @foreach (var photo in photos)
            {
                <div class="photo-tile" data-photo-id="@photo.Id" data-part="@(photo.Part?.ToString() ?? "")">
                    <img src="/api/photos/@photo.Id/thumbnail" loading="lazy"
                         alt="@stage photo @photo.SequenceNumber.ToString("000") for @(Model.Vehicle.Reg ?? Model.Vehicle.Vin)" />
                    <span class="photo-seq">@photo.SequenceNumber.ToString("000")</span>
                    @if (photo.Part is not null)
                    {
                        <span class="photo-part">@Html.DisplayFor(_ => photo.Part)</span>
                    }
                    <a class="photo-view" asp-page="/Photos/View" asp-route-id="@photo.Id" title="View photo">⤢</a>
                    @if (User.IsAdmin())
                    {
                        <button type="button" class="photo-delete" data-photo-id="@photo.Id" title="Delete">×</button>
                    }
                </div>
            }
        </div>
    }
}

@* data-selection-ids marks this as a form multiselect.js should populate with the selected
   photo ids. It used to be found by its hard-coded id; the attribute is what allows a second
   bulk action to share the same selection. *@
<form id="selection-download-form" data-selection-ids method="post" action="/api/photos/download"></form>

<div id="selection-bar" class="selection-bar d-none">
    <span id="selection-count"></span>
    <span class="flex-spacer"></span>
    @if (User.CanUpload())
    {
        <select id="tag-part" class="form-select form-select-sm" style="width:auto" aria-label="Set part for selected photos">
            <option value="">Set part…</option>
            <option value="__clear__">— clear part —</option>
            @foreach (var part in Enum.GetValues<MainProjectNumoPart.Models.Part>())
            {
                <option value="@part">@Html.DisplayFor(_ => part)</option>
            }
        </select>
    }
    <button type="button" id="selection-clear" class="btn btn-sm btn-outline-light">Clear</button>
    <button type="submit" form="selection-download-form" class="btn btn-sm btn-primary">⬇ Download zip</button>
    @* Separate from "Download zip" above (the plain, no-frills bulk download): this is the
       richer export a client can actually be handed — each photo carries its stage, part, date
       and comment thread, and damage-mark pins can be burned onto the image on request. Posted
       via fetch rather than a plain form submit since the request body is JSON (format +
       includeDamageMarks aren't just an id list) and the response needs to become a downloaded
       file client-side rather than a browser navigation. *@
    <select id="export-format" class="form-select form-select-sm" style="width:auto" aria-label="Export format">
        <option value="Pdf">Export: PDF</option>
        <option value="Zip">Export: zip</option>
    </select>
    <label class="form-check form-check-inline text-light small mb-0" title="Burn each damage mark's pin onto the photo">
        <input type="checkbox" id="export-include-marks" class="form-check-input" />
        Include damage marks
    </label>
    <button type="button" id="export-button" class="btn btn-sm btn-outline-light">Export</button>
    <div id="export-error" class="text-danger small"></div>
</div>

<script src="~/js/multiselect.js"></script>
<script>
    document.getElementById('export-button')?.addEventListener('click', async (e) => {
        const ids = window.PhotoSelection.ids();
        if (ids.length === 0) return;

        const button = e.target;
        const errorEl = document.getElementById('export-error');
        errorEl.textContent = '';
        button.disabled = true;
        try {
            const format = document.getElementById('export-format').value;
            const includeDamageMarks = document.getElementById('export-include-marks').checked;

            const response = await fetch('/api/photos/export', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids, format, includeDamageMarks })
            });

            if (response.status !== 200) {
                errorEl.textContent = (await response.text()) || 'Could not export the selected photos.';
                return;
            }

            const blob = await response.blob();
            const disposition = response.headers.get('Content-Disposition') || '';
            const match = disposition.match(/filename="([^"]+)"/);
            const fileName = match ? match[1] : `photos.${format.toLowerCase()}`;

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
        } finally {
            button.disabled = false;
        }
    });
</script>

@if (Model.Vehicle.Photos.Count > 0)
{
    <script>
        (function () {
            const badges = document.querySelectorAll('.coverage-badge');
            if (badges.length === 0) return;

            const counts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.PhotoCountsByPart.ToDictionary(k => k.Key.ToString(), v => v.Value)));

            const note = document.getElementById('coverage-filter-note');
            let active = null;

            // Filtering is client-side: the photos are already on the page, so a round-trip
            // would only make it slower and lose the selection.
            function applyFilter() {
                badges.forEach(b => b.classList.toggle('active', b.dataset.part === active));
                document.querySelectorAll('.photo-tile').forEach(t => {
                    t.classList.toggle('part-hidden', active !== null && t.dataset.part !== active);
                });

                if (active === null) {
                    note.textContent = '';
                } else {
                    const n = counts[active] || 0;
                    note.innerHTML = `Showing ${n} photo(s) of that part. <a href="#" id="coverage-clear">Show all</a>`;
                    document.getElementById('coverage-clear').addEventListener('click', (ev) => {
                        ev.preventDefault();
                        active = null;
                        applyFilter();
                    });
                }
            }

            badges.forEach(b => b.addEventListener('click', () => {
                active = (active === b.dataset.part) ? null : b.dataset.part;
                applyFilter();
            }));
        })();
    </script>
}

@if (User.CanUpload())
{
    <script>
        document.getElementById('tag-part').addEventListener('change', async (e) => {
            const raw = e.target.value;
            if (!raw) return;
            const ids = window.PhotoSelection.ids();
            if (ids.length === 0) { e.target.value = ''; return; }

            const response = await fetch('/api/photos/part', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ids, part: raw === '__clear__' ? null : raw })
            });

            // Exact status, not response.ok — a role-denied request answers 302 to
            // /Account/AccessDenied, which fetch follows to a 200 and would look like success.
            if (response.status === 200) {
                window.location.reload();
            } else {
                alert(await response.text() || 'Could not set the part.');
                e.target.value = '';
            }
        });
    </script>
}

@if (User.IsAdmin())
{
    <script>
        document.querySelectorAll('.photo-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this photo? This cannot be undone.')) return;
                const id = btn.dataset.photoId;
                const response = await fetch(`/api/photos/${id}`, { method: 'DELETE' });
                // Check the exact success status, NOT response.ok. A role-denied request is
                // answered with a 302 to /Account/AccessDenied, which fetch follows to a 200 HTML
                // page — response.ok would be true and the tile would vanish while the photo
                // survived, telling the user a deletion happened that didn't.
                if (response.status === 204) {
                    document.querySelector(`.photo-tile[data-photo-id="${id}"]`).remove();
                } else {
                    alert('Delete failed.');
                }
            });
        });
    </script>

    @* Control and script both inside this single admin gate, matching the per-photo delete above:
       a non-admin receives no delete markup and no delete JavaScript at all. *@
    <div class="danger-zone mt-5">
        <h4 class="text-danger">Delete this vehicle</h4>
        <p class="text-muted small mb-2">
            Permanently removes this vehicle, all @Model.Vehicle.Photos.Count photo records, and
            every stored image file. This cannot be undone.
        </p>
        <label class="form-label small" for="delete-confirm">
            Type <code>@(Model.Vehicle.Vin ?? Model.Vehicle.Reg)</code> to confirm
        </label>
        <input id="delete-confirm" class="form-control" style="max-width:340px" autocomplete="off" />
        <button type="button" id="delete-vehicle" class="btn btn-danger mt-2"
                data-vehicle-id="@Model.Vehicle.Id">Delete vehicle</button>
        <div id="delete-error" class="text-danger small mt-2"></div>
    </div>

    <script>
        document.getElementById('delete-vehicle').addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            const confirmation = document.getElementById('delete-confirm').value;
            if (!confirm('Delete this vehicle and all of its photos? This cannot be undone.')) return;

            btn.disabled = true;
            const response = await fetch(`/api/vehicles/${btn.dataset.vehicleId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ confirmation })
            });

            // Exact status, not response.ok — see the note on the photo delete above. The typed
            // confirmation is re-checked server-side; this input is convenience, not the control.
            if (response.status === 204) {
                window.location.href = '/';
                return;
            }

            btn.disabled = false;
            document.getElementById('delete-error').textContent =
                (await response.text()) || 'Delete failed.';
        });
    </script>
}
