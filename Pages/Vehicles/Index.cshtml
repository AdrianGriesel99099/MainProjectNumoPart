@page
@model MainProjectNumoPart.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "All vehicles";
}

<h3>All vehicles</h3>
<p class="text-muted small">@Model.TotalCount vehicle@(Model.TotalCount == 1 ? "" : "s") total.</p>

<table class="table">
    <thead><tr><th>VIN</th><th>Reg</th><th>Make/Model</th><th>Added</th><th>Tagging</th></tr></thead>
    <tbody>
    @if (Model.Vehicles.Count == 0)
    {
        <tr><td colspan="5" class="text-muted">No vehicles yet.</td></tr>
    }
    @foreach (var vehicle in Model.Vehicles)
    {
        <tr>
            <td><a asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Vin</a></td>
            <td><a asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Reg</a></td>
            <td>@vehicle.MakeModel</td>
            <td>@vehicle.CreatedAtUtc.ToString("d MMM yyyy")</td>
            <td>
            @if (Model.UntaggedCounts.TryGetValue(vehicle.Id, out var untaggedCount))
            {
                <a class="badge bg-warning text-dark" asp-page="/Photos/Index"
                   asp-route-VinOrReg="@(vehicle.Vin ?? vehicle.Reg)" asp-route-PartFilter="untagged">
                    @untaggedCount untagged
                </a>
            }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Vehicle list pages">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="/Vehicles/Index" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="/Vehicles/Index" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
