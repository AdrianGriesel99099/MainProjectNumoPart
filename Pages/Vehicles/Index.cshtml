@page
@model MainProjectNumoPart.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "All vehicles";
}

<h3>All vehicles</h3>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <input type="text" name="Search" value="@Model.Search" class="form-control"
               placeholder="Search VIN, Reg or Make/Model" />
    </div>
    <div class="col-auto form-check">
        <input type="checkbox" name="NeedsTaggingOnly" value="true" id="needsTaggingOnly"
               class="form-check-input" checked="@Model.NeedsTaggingOnly" />
        <label class="form-check-label" for="needsTaggingOnly">Needs tagging only</label>
    </div>
    <div class="col-auto form-check">
        <input type="checkbox" name="StaleOnly" value="true" id="staleOnly"
               class="form-check-input" checked="@Model.StaleOnly" />
        <label class="form-check-label" for="staleOnly">Needs attention only</label>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.NeedsTaggingOnly || Model.StaleOnly)
    {
        <div class="col-auto">
            <a asp-page="/Vehicles/Index" class="btn btn-link">Clear</a>
        </div>
    }
</form>

<p class="text-muted small">
    @Model.TotalCount vehicle@(Model.TotalCount == 1 ? "" : "s")
    @(string.IsNullOrWhiteSpace(Model.Search) ? "total." : $"matching \"{Model.Search}\".")
    @(Model.NeedsTaggingOnly ? "Showing only vehicles that still need tagging." : "")
    @(Model.StaleOnly ? "Showing only vehicles that need attention." : "")
</p>

<table class="table">
    <thead><tr><th>VIN</th><th>Reg</th><th>Make/Model</th><th>Added</th><th>Stage</th><th>Last activity</th><th>Tagging</th></tr></thead>
    <tbody>
    @if (Model.Vehicles.Count == 0)
    {
        <tr><td colspan="7" class="text-muted">No vehicles yet.</td></tr>
    }
    @foreach (var vehicle in Model.Vehicles)
    {
        <tr>
            <td><a asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Vin</a></td>
            <td><a asp-page="/Vehicles/Details" asp-route-id="@vehicle.Id">@vehicle.Reg</a></td>
            <td>@vehicle.MakeModel</td>
            <td>@vehicle.CreatedAtUtc.ToString("d MMM yyyy")</td>
            <td>
            @if (Model.CurrentStage.TryGetValue(vehicle.Id, out var stage))
            {
                <span class="badge bg-info text-dark">@stage</span>
            }
            else
            {
                <span class="text-muted">No photos yet</span>
            }
            </td>
            <td>
            @if (Model.LastActivity.TryGetValue(vehicle.Id, out var lastActivity))
            {
                <text>@lastActivity.ToString("d MMM yyyy")</text>
                @if (MainProjectNumoPart.Services.VehicleLastActivity.IsStale(lastActivity, DateTime.UtcNow))
                {
                    <span class="badge bg-danger ms-1">Stale</span>
                }
            }
            </td>
            <td>
            @if (Model.UntaggedCounts.TryGetValue(vehicle.Id, out var untaggedCount))
            {
                <a class="badge bg-warning text-dark" asp-page="/Photos/Index"
                   asp-route-VinOrReg="@(vehicle.Vin ?? vehicle.Reg)" asp-route-PartFilter="untagged">
                    @untaggedCount untagged
                </a>
            }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Vehicle list pages">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="/Vehicles/Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-Search="@Model.Search" asp-route-NeedsTaggingOnly="@Model.NeedsTaggingOnly" asp-route-StaleOnly="@Model.StaleOnly">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="/Vehicles/Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-Search="@Model.Search" asp-route-NeedsTaggingOnly="@Model.NeedsTaggingOnly" asp-route-StaleOnly="@Model.StaleOnly">Next</a>
            </li>
        </ul>
    </nav>
}
