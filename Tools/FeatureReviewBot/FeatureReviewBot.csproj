<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FeatureReviewBot</RootNamespace>
  </PropertyGroup>

  <!-- No project or package references: this is a plain HTTP client (HttpClient and
       System.Text.Json are both in the BCL) talking to the site's own /api/bot/feature-proposals
       routes and to the Anthropic API, with no database access and no shared schema to sync. -->

</Project>
