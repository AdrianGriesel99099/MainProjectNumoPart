<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FeatureReviewRelay</RootNamespace>
  </PropertyGroup>

  <!-- Pure HTTP + file I/O (HttpClient and System.Text.Json are both in the BCL), with no AI
